# Copiar este archivo como .env y completar los valores.
# .env NO se sube al repositorio.
# Datos en Supabase > Connect > Session pooler.

DB_HOST=aws-0-REGION.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.TU_PROYECTO

# Si se deja vacío, la ETL la pide por teclado al ejecutar.
DB_PASSWORD=

# Esquema donde se crean las tablas.
DB_SCHEMA=project_etl
